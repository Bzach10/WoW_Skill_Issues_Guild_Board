# Copy this file to ".env" in the repo root and fill in the real values.
#
#     cp .env.example .env
#
# ".env" is gitignored and must NEVER be committed. This ".env.example"
# is committed on purpose — it documents the variable names only, and
# must never contain a real credential.

# RunPod API key. Create at https://console.runpod.io/user/settings
# (User Settings -> API Keys). Starts with "rpa_".
RUNPOD_API_KEY=

# Optional. The ComfyUI endpoint the pipeline generates against.
# Leave blank to use the local instance at http://127.0.0.1:8188.
# For a RunPod pod this is  https://<POD_ID>-8188.proxy.runpod.net
COMFY_BASE_URL=

# Optional. Set once a network volume exists, so provisioning reuses it
# instead of creating another one (volumes bill separately from pods).
RUNPOD_NETWORK_VOLUME_ID=
