{#
  THE S.S. WIPE FEST — the guild's ship. One page, eleven rooms, walked
  top to bottom (HANGOUT_DESIGN Phase 0). The Wanted Board is pinned on
  the Main Deck as the heart of the ship.
#}
<!DOCTYPE html>
<html lang="en" data-crew-theme="{{ default_theme }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>S.S. Wipe Fest — the guild's ship</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🚢</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="{{ font_css_url }}" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Special+Elite&display=swap" rel="stylesheet">
<style>
{%- for key, t in themes.items() %}
html[data-crew-theme="{{ key }}"]{
  --bg:{{ t.bg }}; --text:{{ t.text }}; --heading:{{ t.heading }};
  --accent:{{ t.accent }}; --panel:{{ t.panel }}; --line:{{ t.line }};
  --muted:{{ t.muted }};
  --font-display:'{{ t.display }}',Georgia,serif;
  --font-body:'{{ t.body }}',system-ui,sans-serif;
  color-scheme:{{ t.scheme }};
}
{%- endfor %}
:root{--tank:#6ea8fe; --healer:#5fce9b; --dps:#e07b6b;
  --brass:#c9974a; --rope:#b98b52; --measure:1180px;}
*{box-sizing:border-box;margin:0;padding:0;}
html{overflow-x:hidden; scroll-behavior:smooth;}
body{background:var(--bg); color:var(--text); font-family:var(--font-body);
  font-size:16px; line-height:1.6; overflow-x:hidden; -webkit-font-smoothing:antialiased;}
a{color:var(--accent);}
.wrap{max-width:var(--measure); margin:0 auto; padding:0 22px;}
.private{background:repeating-linear-gradient(45deg,
    color-mix(in srgb,var(--accent) 22%, var(--bg)) 0 14px,
    color-mix(in srgb,var(--accent) 12%, var(--bg)) 14px 28px);
  border-bottom:1px solid var(--line); text-align:center; padding:9px 16px;
  font-size:12px; letter-spacing:.16em; text-transform:uppercase;}
.private b{color:var(--accent);}

/* ---------------- the figurehead (masthead) ---------------- */
.figurehead{position:relative; overflow:hidden; border-bottom:1px solid var(--line);
  aspect-ratio:21/9; max-height:76vh; display:flex; align-items:flex-end;}
@media (max-width:900px){.figurehead{aspect-ratio:2/1;}}
@media (max-width:560px){.figurehead{aspect-ratio:4/5;}}
.figurehead .art{position:absolute; inset:0; background-size:cover;
  background-position:center 28%;}
.figurehead .art::after{content:""; position:absolute; inset:0;
  background:
    radial-gradient(120% 70% at 50% 100%, color-mix(in srgb,var(--bg) 62%, transparent), transparent 70%),
    linear-gradient(180deg, color-mix(in srgb,var(--bg) 24%, transparent) 0%,
      transparent 20%, color-mix(in srgb,var(--bg) 42%, transparent) 50%,
      color-mix(in srgb,var(--bg) 74%, transparent) 74%, var(--bg) 100%);}
.figurehead .plate{position:relative; z-index:1; width:100%; text-align:center;
  padding:0 22px 34px;}
.figurehead .ensign{display:inline-block; font-size:12px; letter-spacing:.28em;
  text-transform:uppercase; color:#fff; margin-bottom:14px;
  padding:5px 16px; border-radius:999px;
  background:color-mix(in srgb,var(--bg) 42%, transparent); backdrop-filter:blur(4px);
  text-shadow:0 1px 3px rgba(0,0,0,.9);}
.figurehead h1{font-family:var(--font-display); font-weight:900; line-height:.9;
  font-size:clamp(44px,10vw,120px); color:#fff;
  text-shadow:0 4px 30px rgba(0,0,0,.75), 0 1px 3px rgba(0,0,0,.6);}
.figurehead .tag{margin:14px auto 0; max-width:54ch; color:#f7f0e6;
  font-size:clamp(14px,2vw,17px);
  text-shadow:0 2px 6px rgba(0,0,0,.9), 0 0 16px rgba(0,0,0,.7);}
.figurehead .tag b{color:#ffcf7a; text-shadow:0 2px 6px rgba(0,0,0,.95);}
.aboard{display:inline-flex; gap:10px; margin-top:20px; flex-wrap:wrap; justify-content:center;}
.aboard a{font-size:13px; text-decoration:none; padding:10px 18px; border-radius:999px;
  background:color-mix(in srgb,var(--bg) 30%, transparent); color:#fff;
  border:1px solid rgba(255,255,255,.35); backdrop-filter:blur(6px);
  text-shadow:0 1px 4px rgba(0,0,0,.6); transition:all .2s;}
.aboard a.primary{background:var(--accent); color:var(--bg); border-color:var(--accent);
  font-weight:700; text-shadow:none;}
.aboard a:hover{transform:translateY(-2px);}

/* ---------------- the deck manifest (sticky nav) ---------------- */
.manifest{position:sticky; top:0; z-index:50; background:color-mix(in srgb,var(--bg) 92%, transparent);
  backdrop-filter:blur(12px); border-bottom:1px solid var(--line);
  box-shadow:0 6px 20px -14px rgba(0,0,0,.7);}
.manifest-in{display:flex; align-items:center; gap:6px; overflow-x:auto;
  max-width:1320px; margin:0 auto; padding:9px 16px; scrollbar-width:thin;}
.manifest-in::-webkit-scrollbar{height:5px;}
.manifest-in::-webkit-scrollbar-thumb{background:var(--line); border-radius:3px;}
.manifest .brand{flex:0 0 auto; display:flex; align-items:center; gap:8px;
  font-family:var(--font-display); font-weight:700; color:var(--heading);
  text-decoration:none; padding-right:8px; margin-right:4px;
  border-right:1px solid var(--line); font-size:14px; white-space:nowrap;}
.deckchip{flex:0 0 auto; display:inline-flex; align-items:center; gap:6px;
  font-size:12.5px; text-decoration:none; color:var(--muted); white-space:nowrap;
  padding:7px 12px; border-radius:999px; transition:all .2s;}
.deckchip:hover{color:var(--text); background:color-mix(in srgb,var(--line) 45%, transparent);}
.deckchip.active{color:var(--bg); background:var(--accent);}
.deckchip .dot{font-size:14px;}
.deck-split{flex:0 0 auto; font-size:9px; letter-spacing:.18em; text-transform:uppercase;
  color:var(--faint,var(--muted)); opacity:.7; padding:0 4px; white-space:nowrap;}

/* ---------------- a room ---------------- */
.room{position:relative; padding:56px 0 44px; border-bottom:1px solid
  color-mix(in srgb,var(--line) 60%, transparent); scroll-margin-top:58px;}
.room:nth-child(even of .room){background:color-mix(in srgb,var(--panel) 22%, var(--bg));}
.room-head{text-align:center; margin-bottom:30px;}
.porthole{width:64px; height:64px; margin:0 auto 14px; border-radius:50%;
  display:grid; place-items:center; font-size:30px;
  background:radial-gradient(circle at 35% 30%,
    color-mix(in srgb,var(--accent) 26%, var(--panel)),
    color-mix(in srgb,var(--panel) 90%, var(--bg)));
  border:2px solid color-mix(in srgb,var(--accent) 45%, var(--line));
  box-shadow:0 0 0 6px color-mix(in srgb,var(--panel) 60%, transparent),
    inset 0 2px 10px rgba(0,0,0,.4);}
.room h2{font-family:var(--font-display); font-weight:900; color:var(--heading);
  font-size:clamp(28px,5vw,46px); line-height:1;}
.room .sub{color:var(--muted); margin-top:10px; max-width:60ch; margin-inline:auto;
  font-size:14.5px;}
.room .sub b{color:var(--accent);}
.deeper{display:inline-block; margin-top:18px; font-size:13px; font-weight:600;
  text-decoration:none; padding:9px 18px; border-radius:999px;
  border:1px solid var(--line); color:var(--text); transition:all .2s;}
.deeper:hover{border-color:var(--accent); color:var(--accent);}

.card{background:var(--panel); border:1px solid var(--line); border-radius:16px;
  padding:20px 22px;}
.grid{display:grid; gap:16px;}
.g3{grid-template-columns:repeat(3,1fr);}
.g2{grid-template-columns:repeat(2,1fr);}
@media (max-width:820px){.g3{grid-template-columns:1fr;} .g2{grid-template-columns:1fr;}}

/* Crow's Nest lookout tiles */
.lookout{display:grid; gap:16px; grid-template-columns:repeat(4,1fr);
  max-width:var(--measure); margin:0 auto;}
@media (max-width:820px){.lookout{grid-template-columns:repeat(2,1fr);}}
@media (max-width:460px){.lookout{grid-template-columns:1fr;}}
.look{background:var(--panel); border:1px solid var(--line); border-radius:16px;
  padding:20px; text-align:center;}
.look .k{font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--muted);}
.look .big{font-family:var(--font-display); font-size:clamp(22px,3vw,30px);
  color:var(--heading); margin:8px 0 4px; line-height:1.05;}
.look .d{font-size:12.5px; color:var(--muted);}
.look .accent{color:var(--accent);}
.countdown{font-variant-numeric:tabular-nums;}

/* Captain's Log + Who's Popping Off */
.log{max-width:820px; margin:0 auto;}
.log .beat{display:flex; gap:12px; padding:11px 0; border-bottom:1px dashed
  color-mix(in srgb,var(--line) 70%, transparent); font-size:15px;}
.log .beat:last-child{border-bottom:0;}
.log .beat .n{flex:0 0 auto; color:var(--accent); font-family:var(--font-display);
  font-weight:700;}
.popoff{display:grid; gap:12px; grid-template-columns:repeat(2,1fr);
  max-width:var(--measure); margin:22px auto 0;}
@media (max-width:760px){.popoff{grid-template-columns:1fr;}}
.shout{display:flex; gap:13px; align-items:flex-start; background:var(--panel);
  border:1px solid var(--line); border-left:3px solid var(--accent);
  border-radius:12px; padding:13px 16px;}
.shout .ic{font-size:22px; flex:0 0 auto;}
.shout b{color:var(--heading);}
.shout span{color:var(--muted); font-size:14px;}

/* generic pill list / legendary lines */
.legend-lines{list-style:none; display:grid; gap:5px; margin-top:12px;}
.legend-lines li{display:flex; justify-content:space-between; gap:14px;
  font-size:13px; color:#e8b45e;}
.legend-lines li span:last-child{color:var(--muted);}

/* Casino debt plaque */
.plaque{max-width:560px; margin:0 auto; text-align:center;
  background:linear-gradient(180deg, #241a12, #17100b);
  border:1px solid #5a4023; border-radius:18px; padding:26px 24px;
  box-shadow:0 22px 60px -30px #000, inset 0 0 40px rgba(201,151,74,.12);}
.plaque .pt{font-family:var(--font-display); color:#e8b45e; font-size:19px;
  letter-spacing:.04em;}
.plaque .owed{font-family:'Special Elite',monospace; color:#ffb733;
  font-size:clamp(34px,7vw,58px); font-weight:400; margin:6px 0 2px;
  text-shadow:0 0 22px rgba(255,150,40,.55); font-variant-numeric:tabular-nums;}
.plaque .owed::before{content:"g"; font-size:.5em; vertical-align:super;
  margin-right:4px; opacity:.7;}
.plaque .note{color:#c79a5c; font-size:12px; letter-spacing:.06em;}
.plaque .flavor{color:#a98a63; font-style:italic; font-size:13px; margin-top:14px;}
.plaque .req{color:#e5484d; font-size:11px; letter-spacing:.1em;
  text-transform:uppercase; margin-top:6px;}
.casino-extra{display:grid; gap:16px; grid-template-columns:repeat(2,1fr);
  max-width:var(--measure); margin:24px auto 0;}
@media (max-width:760px){.casino-extra{grid-template-columns:1fr;}}
.wheel{text-align:center;}
.wheel .disc{width:120px; height:120px; margin:6px auto 14px; border-radius:50%;
  background:conic-gradient(#c9974a 0 45deg,#7a1f12 45deg 90deg,#20152c 90deg 135deg,
    #57e08a 135deg 180deg,#c9974a 180deg 225deg,#7a1f12 225deg 270deg,
    #20152c 270deg 315deg,#57e08a 315deg 360deg);
  border:4px solid var(--brass); box-shadow:0 10px 30px -12px #000;
  position:relative; transition:transform 2.6s cubic-bezier(.15,.9,.2,1);}
.wheel .disc::after{content:"▲"; position:absolute; top:-16px; left:50%;
  transform:translateX(-50%); color:var(--brass);}
.wheel button, .poll button{font:inherit; font-size:13px; cursor:pointer;
  padding:9px 18px; border-radius:999px; border:1px solid var(--brass);
  background:transparent; color:var(--accent); transition:all .2s;}
.wheel button:hover, .poll button:hover{background:var(--accent); color:var(--bg);}
.wheel .verdict{margin-top:12px; min-height:1.4em; font-style:italic; color:var(--muted);}
.poll .opt{display:flex; align-items:center; gap:10px; margin:8px 0; font-size:14px;}
.poll .bar{flex:1; height:8px; border-radius:999px; overflow:hidden;
  background:color-mix(in srgb,var(--line) 80%, var(--bg));}
.poll .bar i{display:block; height:100%; background:var(--accent);}
.poll .pct{color:var(--muted); font-size:12px; width:34px; text-align:right;}

/* Item of the Month + MOTD (Galley) */
.galley-in{display:grid; gap:20px; grid-template-columns:1.1fr 1fr; align-items:center;
  max-width:960px; margin:0 auto;}
@media (max-width:760px){.galley-in{grid-template-columns:1fr;}}
.itemcard{text-align:center; background:linear-gradient(180deg,#1c1526,#140e1c);
  border:1px solid #4a3a2a; border-radius:16px; padding:22px;}
.itemcard .lg{color:#ff8000; font-family:var(--font-display); font-size:20px;}
.itemcard .lg-sub{color:#e8b45e; font-size:12px; margin-top:2px;}
.itemcard .glyph{font-size:56px; margin:10px 0;}
.motd{background:var(--panel); border:1px solid var(--line); border-radius:16px;
  padding:22px 24px;}
.motd .q{font-family:var(--font-display); font-size:clamp(18px,2.6vw,24px);
  color:var(--heading); line-height:1.25;}
.motd .src{color:var(--muted); font-size:12px; margin-top:12px; letter-spacing:.1em;
  text-transform:uppercase;}

/* Brig */
.brig{max-width:620px; margin:0 auto; text-align:center; background:
  repeating-linear-gradient(90deg, var(--panel) 0 34px,
    color-mix(in srgb,var(--bg) 60%, var(--panel)) 34px 40px);
  border:1px solid var(--line); border-radius:16px; padding:28px 24px;
  position:relative;}
.brig .bars{position:absolute; inset:0; border-radius:16px; pointer-events:none;
  background:repeating-linear-gradient(90deg, transparent 0 30px,
    color-mix(in srgb,#000 30%, transparent) 30px 34px);}
.brig .shamed{font-family:var(--font-display); font-size:clamp(26px,4vw,38px);
  color:var(--heading);}
.brig .tag{display:inline-block; margin-bottom:10px; font-size:11px;
  letter-spacing:.16em; text-transform:uppercase; color:var(--dps);}
.brig .note{color:var(--muted); margin-top:6px;}
.brig .optout{margin-top:16px; font-size:12.5px; color:var(--muted);
  border-top:1px dashed var(--line); padding-top:14px;}

/* The Hold — graveyard */
.hold-head{text-align:center; margin-bottom:22px;}
.tombs{display:grid; gap:14px; grid-template-columns:repeat(3,1fr);
  max-width:var(--measure); margin:0 auto;}
@media (max-width:820px){.tombs{grid-template-columns:repeat(2,1fr);}}
@media (max-width:460px){.tombs{grid-template-columns:1fr;}}
.tomb{background:linear-gradient(180deg,#2a2434,#1c1726);
  border:1px solid #3c2e4a; border-radius:14px 14px 6px 6px; padding:22px 16px 16px;
  text-align:center; position:relative;
  box-shadow:inset 0 30px 40px -30px rgba(0,0,0,.6);}
.tomb::before{content:"✝"; display:block; color:#7c6d8c; font-size:16px; margin-bottom:6px;}
.tomb.reserved{border-color:var(--accent);
  box-shadow:0 0 0 1px color-mix(in srgb,var(--accent) 40%, transparent),
    inset 0 30px 40px -30px rgba(0,0,0,.6);}
/* the tomb is always dark stone, so its text is fixed-light, not theme-tinted */
.tomb .rip{font-size:10px; letter-spacing:.2em; color:#9c8db0;}
.tomb .who{font-family:var(--font-display); color:#ece3f2; font-size:17px;
  margin:5px 0 6px; line-height:1.1;}
.tomb .ep{font-size:12.5px; color:#b9abc9; font-style:italic;}
.tomb.reserved .who{color:var(--brass);}
.tomb.reserved .ep{color:#d8c8a0;}
.tomb .fire{font-size:20px; margin-top:8px;}

.roast-card{max-width:640px; margin:26px auto 0; text-align:center; background:
  linear-gradient(180deg, color-mix(in srgb,var(--accent) 12%, var(--panel)), var(--panel));
  border:1px solid var(--accent); border-radius:16px; padding:24px;}
.roast-card .k{font-size:11px; letter-spacing:.18em; text-transform:uppercase;
  color:var(--accent);}
.roast-card .q{font-family:var(--font-display); font-size:clamp(22px,3.5vw,30px);
  color:var(--heading); margin:10px 0 8px;}
.roast-card .by{color:var(--muted); font-size:14px;}
.hall-flame{max-width:640px; margin:18px auto 0; text-align:center; color:var(--muted);
  font-size:13px;}
.hall-flame b{color:var(--accent);}

/* Bar life + pulse placeholder */
.bar-cols{display:grid; gap:16px; grid-template-columns:1.3fr 1fr;
  max-width:var(--measure); margin:0 auto; align-items:start;}
@media (max-width:880px){.bar-cols{grid-template-columns:1fr;}}
.pulse .row{display:flex; gap:10px; padding:10px 0; border-bottom:1px dashed
  color-mix(in srgb,var(--line) 70%, transparent); font-size:14px;}
.pulse .row:last-child{border-bottom:0;}
.pulse .ch{flex:0 0 auto; font-size:11px; color:var(--accent); font-weight:700;
  min-width:104px;}
.soon{display:inline-block; font-size:10px; letter-spacing:.12em; text-transform:uppercase;
  color:var(--muted); border:1px solid var(--line); border-radius:999px;
  padding:2px 9px; margin-left:8px;}
.shrine .jk{padding:12px 0; border-bottom:1px dashed color-mix(in srgb,var(--line) 70%, transparent);}
.shrine .jk:last-child{border-bottom:0;}
.shrine .jk b{color:var(--heading); font-family:var(--font-display);}
.shrine .jk p{color:var(--muted); font-size:13.5px; margin-top:3px;}
.guestbook{margin-top:16px; text-align:center;}
.guestbook button{font:inherit; font-size:13px; cursor:pointer; padding:9px 18px;
  border-radius:999px; border:1px solid var(--accent); background:transparent;
  color:var(--accent);}

/* Helm preview — reuse a compact ports strip */
.ports-strip{display:flex; gap:8px; overflow-x:auto; padding:10px 4px 16px;
  max-width:var(--measure); margin:0 auto; scroll-snap-type:x proximity;}
.pstop{flex:0 0 auto; width:88px; text-align:center; scroll-snap-align:center;
  text-decoration:none; color:inherit;}
.pstop .pd{width:64px; height:64px; border-radius:50%; margin:0 auto 6px;
  background-size:cover; background-position:center; border:2px solid var(--line);
  background-color:color-mix(in srgb,var(--accent) 20%, var(--panel));}
.pstop.here .pd{border-color:var(--accent);
  box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 35%, transparent);}
.pstop .pm{font-size:10px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted);}
.pstop .pn{font-size:11px; color:var(--text);}
.charted-line{text-align:center; color:var(--muted); font-size:13px; margin-top:6px;}
.charted-line b{color:var(--accent); font-family:var(--font-display); font-size:16px;}

/* Slop chest transmog */
.slop{display:grid; gap:14px; grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
  max-width:var(--measure); margin:0 auto;}
.thread{display:flex; gap:12px; align-items:center; background:var(--panel);
  border:1px solid var(--line); border-radius:12px; padding:12px 14px;}
.thread .sw{width:44px; height:44px; border-radius:8px; flex:0 0 auto;
  background:color-mix(in srgb,var(--accent) 22%, var(--panel));
  display:grid; place-items:center; font-size:20px;}
.thread b{color:var(--heading);}
.thread span{color:var(--muted); font-size:12.5px;}

.foot{padding:30px 0 70px; text-align:center; color:var(--muted); font-size:13px;}
.foot b{color:var(--accent);}

{% include "web/_wanted_css.html.j2" %}
{% include "web/_nav_css.html.j2" %}
</style>
</head>
<body>
<div class="private">Test run · <b>not final</b> · welcome aboard before we make it real</div>

{# ---------------- FIGUREHEAD ---------------- #}
<header class="figurehead">
  {%- if scene and scene.hero %}
  <div class="art" style="background-image:url('{{ scene.hero }}');"></div>
  {%- endif %}
  <div class="plate">
    <div class="ensign">⚓ Skill Issues · Bleeding Hollow · she sails the Voyage Map ⚓</div>
    <h1>S.S. Wipe Fest</h1>
    <p class="tag">Welcome aboard. The whole guild lives on this ship — a
      <b>bar</b>, a <b>casino</b>, a <b>brig</b> and a <b>hold</b> full of tombstones.
      Below decks is where we actually hang out. Mind the fire.</p>
    <div class="aboard">
      <a class="primary" href="#main-deck">Board the ship ↓</a>
      <a href="#the-bar">Straight to the Bar 🍺</a>
    </div>
  </div>
</header>

{# ---------------- DECK MANIFEST NAV ---------------- #}
<nav class="manifest" aria-label="The decks">
  <div class="manifest-in">
    <a class="brand" href="#top">⚓ S.S. Wipe Fest</a>
    <span class="deck-split">Above</span>
    <a class="deckchip" href="#crows-nest"><span class="dot">🔭</span>Crow's Nest</a>
    <a class="deckchip" href="#main-deck"><span class="dot">⚓</span>Main Deck</a>
    <a class="deckchip" href="#helm"><span class="dot">🧭</span>Helm</a>
    <a class="deckchip" href="#quarters"><span class="dot">👑</span>Captain's Quarters</a>
    <span class="deck-split">Below</span>
    <a class="deckchip" href="#the-bar"><span class="dot">🍺</span>The Bar</a>
    <a class="deckchip" href="#galley"><span class="dot">🍳</span>Galley</a>
    <a class="deckchip" href="#casino"><span class="dot">🎰</span>Casino</a>
    <a class="deckchip" href="#engine"><span class="dot">⚙️</span>Engine Room</a>
    <a class="deckchip" href="#slop-chest"><span class="dot">🧵</span>Slop Chest</a>
    <a class="deckchip" href="#brig"><span class="dot">🔒</span>The Brig</a>
    <a class="deckchip" href="#hold"><span class="dot">⚰️</span>The Hold</a>
  </div>
</nav>

<main id="top">

{# ========== 🔭 CROW'S NEST ========== #}
<section class="room" id="crows-nest">
  <div class="room-head">
    <div class="porthole">🔭</div>
    <h2>The Crow's Nest</h2>
    <p class="sub">On watch. What's ahead on the course, and when we sail next.</p>
  </div>
  <div class="lookout">
    <div class="look">
      <div class="k">Next port on the course</div>
      <div class="big accent">{{ ship.crows_nest.next_island.name if ship.crows_nest.next_island else "Course charted" }}</div>
      <div class="d">{{ "the next island to take" if ship.crows_nest.next_island else "every island charted" }}</div>
    </div>
    <div class="look">
      <div class="k">Next boss in our sights</div>
      <div class="big">{{ ship.crows_nest.next_boss.name if ship.crows_nest.next_boss else "Tier cleared" }}</div>
      <div class="d">{{ "not yet on the floor" if ship.crows_nest.next_boss else "they're all dead" }}</div>
    </div>
    <div class="look">
      <div class="k">Next raid muster</div>
      <div class="big countdown" id="raidcount">{{ ship.crows_nest.raid.label|title if ship.crows_nest.raid else "TBD" }}</div>
      <div class="d">{% if ship.crows_nest.raid %}{{ ship.crows_nest.raid.day_name }} · 8 PM · all hands{% else %}watch the notice board{% endif %}</div>
    </div>
    <div class="look">
      <div class="k">Guild standing</div>
      <div class="big">#{{ '{:,}'.format(ship.crows_nest.standing.world) if ship.crows_nest.standing.world else "—" }}</div>
      <div class="d">world · realm #{{ ship.crows_nest.standing.realm if ship.crows_nest.standing.realm else "—" }} · <span class="accent">recruiting deckhands</span></div>
    </div>
  </div>
</section>

{# ========== ⚓ MAIN DECK — THE WANTED BOARD ========== #}
<section class="room" id="main-deck">
  <div class="room-head">
    <div class="porthole">⚓</div>
    <h2>Main Deck — The Wanted Board</h2>
    <p class="sub">The whole crew's on deck. The bounty board pinned to the mast is
      <b>the competition that started this guild</b> — every bounty is a live Mythic+ score.
      {{ wanted.ranked_count }} ranked, top five most wanted.</p>
  </div>
  {% set wanted_embedded = true %}{% include "web/_wanted.html.j2" %}
  <div style="text-align:center;">
    <a class="deeper" href="hall.html">Walk the full deck — all {{ cast_total }} crew →</a>
  </div>
</section>

{# ========== 🧭 HELM & CHART ROOM ========== #}
<section class="room" id="helm">
  <div class="room-head">
    <div class="porthole">🧭</div>
    <h2>The Helm &amp; Chart Room</h2>
    <p class="sub">Where we are in the tier. The season's course laid out as ports —
      the ship's docked at <b>this month's</b>.</p>
  </div>
  {%- if ports %}
  <div class="ports-strip">
    {%- for pt in ports %}
    <a class="pstop{{ ' here' if pt.current }}" href="voyage.html">
      <span class="pd"{% if pt.hero %} style="background-image:url('{{ pt.hero }}');"{% endif %}></span>
      <span class="pm">{{ pt.month_abbr }}</span>
      <span class="pn">{{ pt.title }}</span>
    </a>
    {%- endfor %}
  </div>
  {%- endif %}
  {%- if charted %}
  <p class="charted-line"><b>{{ charted.cleared }}</b> of {{ charted.total }} islands charted this season</p>
  {%- endif %}
  <div style="text-align:center;">
    <a class="deeper" href="voyage.html">Take the wheel — the full Voyage Map →</a>
  </div>
</section>

{# ========== 👑 CAPTAIN'S QUARTERS ========== #}
<section class="room" id="quarters">
  <div class="room-head">
    <div class="porthole">👑</div>
    <h2>The Captain's Quarters</h2>
    <p class="sub">The trophy room — the guild's records and Midnight banners, under lock and key.</p>
  </div>
  <div class="grid g3 wrap">
    {%- set rec = records or {} %}
    {%- if rec.highest_timed_key %}
    <div class="card" style="text-align:center;">
      <div class="k" style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);">Deepest Key</div>
      <div class="big" style="font-family:var(--font-display);font-size:34px;color:var(--heading);">+{{ rec.highest_timed_key.level }}</div>
      <div class="d" style="color:var(--muted);font-size:13px;">{{ rec.highest_timed_key.dungeon }} · {{ rec.highest_timed_key.name|title }}</div>
    </div>
    {%- endif %}
    {%- if rec.best_dps_parse %}
    <div class="card" style="text-align:center;">
      <div class="k" style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);">Sharpest Parse</div>
      <div class="big" style="font-family:var(--font-display);font-size:34px;color:var(--heading);">{{ rec.best_dps_parse.parse }}</div>
      <div class="d" style="color:var(--muted);font-size:13px;">{{ rec.best_dps_parse.boss }} · {{ rec.best_dps_parse.name|title }}</div>
    </div>
    {%- endif %}
    {%- if trophies and trophies.available and trophies.total_points %}
    <div class="card" style="text-align:center;">
      <div class="k" style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);">Achievement Points</div>
      <div class="big" style="font-family:var(--font-display);font-size:34px;color:var(--brass);">{{ '{:,}'.format(trophies.total_points) }}</div>
      <div class="d" style="color:var(--muted);font-size:13px;">{{ trophies.trophies|length }} banners in the hall</div>
    </div>
    {%- endif %}
  </div>
  <div style="text-align:center;">
    <a class="deeper" href="trophy.html">Open the trophy hall →</a>
    <a class="deeper" href="wanted.html">The full leaderboard →</a>
  </div>
</section>

{# ========== 🍺 THE BAR ========== #}
<section class="room" id="the-bar">
  <div class="room-head">
    <div class="porthole">🍺</div>
    <h2>The Bar</h2>
    <p class="sub">The hangout heart. Pull up a stool — <b>Brewzleeh's brews on tap</b>,
      the week's story on the wall, and whoever's popping off getting a round.</p>
  </div>

  {%- if recap and recap.sentences %}
  <div class="card log">
    <div class="k" style="font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin-bottom:10px;">📖 The Captain's Log · this week aboard</div>
    {%- for s in recap.sentences %}
    <div class="beat"><span class="n">{{ loop.index }}.</span><span>{{ s }}</span></div>
    {%- endfor %}
  </div>
  {%- endif %}

  {%- if ship.popping_off %}
  <h3 style="text-align:center;color:var(--muted);font-size:12px;letter-spacing:.2em;text-transform:uppercase;margin:30px 0 0;">📣 Who's Popping Off</h3>
  <div class="popoff">
    {%- for s in ship.popping_off %}
    <div class="shout"><span class="ic">{{ s.icon }}</span>
      <span><b>{{ s.who }}</b> {{ s.line }}</span></div>
    {%- endfor %}
  </div>
  {%- endif %}

  <div class="bar-cols" style="margin-top:30px;">
    <div class="card pulse">
      <div class="k" style="font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin-bottom:6px;">🔥 The Guild Pulse <span class="soon">Discord feed · soon</span></div>
      <div class="row"><span class="ch">#guild-chat</span><span>The week's best lines land here — pulled live once we bridge Discord.</span></div>
      <div class="row"><span class="ch">#memes</span><span>Top meme of the week gets pinned above the bar.</span></div>
      <div class="row"><span class="ch">#gambling</span><span>Whatever Brewzleeh just lost, you'll hear about it here.</span></div>
      <div class="row"><span class="ch">#healmates-bully-corner</span><span>Affectionate. Mostly.</span></div>
      <div class="guestbook">
        <button type="button" onclick="alert('Sign the wall — bridged through Discord soon. Carve your name in the timber.')">✍️ Sign the Wall</button>
      </div>
    </div>
    <div class="card shrine">
      <div class="k" style="font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin-bottom:6px;">📌 Inside-jokes shrine</div>
      {%- for j in ship.inside_jokes %}
      <div class="jk"><b>{{ j.title }}</b><p>{{ j.body }}</p></div>
      {%- endfor %}
    </div>
  </div>
</section>

{# ========== 🍳 THE GALLEY ========== #}
<section class="room" id="galley">
  <div class="room-head">
    <div class="porthole">🍳</div>
    <h2>The Galley</h2>
    <p class="sub">A nook off the Bar. This month's gag item, and the notice that's
      always nailed to the door.</p>
  </div>
  <div class="galley-in">
    <div class="itemcard">
      <div class="lg">{{ ship.galley.item_title }}</div>
      <div class="lg-sub">Requires: Level 60 Degeneracy</div>
      <div class="glyph">🍖</div>
      <div style="color:var(--muted);font-size:13px;">Swaps monthly. Binds on !roll. Do not eat.</div>
    </div>
    <div class="motd">
      <div class="q">“{{ ship.galley.motd }}”</div>
      <div class="src">— Message of the Day</div>
    </div>
  </div>
</section>

{# ========== 🎰 THE CASINO ========== #}
<section class="room" id="casino">
  <div class="room-head">
    <div class="porthole">🎰</div>
    <h2>The Casino</h2>
    <p class="sub">Brewzleeh's domain. The house always wins, and the house is
      <b>also in debt</b>. Spin at your own risk.</p>
  </div>
  {%- if debt %}
  <div class="plaque">
    <div class="pt">{{ debt.title }}</div>
    <div class="owed" id="debtcounter" data-owed="{{ debt.owed|replace(',','') }}">{{ debt.owed }}</div>
    <div class="note">{{ debt.note }}</div>
    {%- if debt.lines %}
    <ul class="legend-lines">
      {%- for ln in debt.lines %}
      <li style="{{ 'color:#57e08a;' if ln.green }}"><span>{{ ln.left }}</span>{% if ln.right %}<span>{{ ln.right }}</span>{% endif %}</li>
      {%- endfor %}
    </ul>
    {%- endif %}
    {%- if debt.flavor %}<div class="flavor">{{ debt.flavor }}</div>{% endif %}
    <div class="req">Requires: An intervention</div>
  </div>
  {%- endif %}
  <div class="casino-extra">
    <div class="card wheel">
      <div class="k" style="font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);">🎡 The Wheel of Debt</div>
      <div class="disc" id="wheeldisc"></div>
      <button type="button" id="spinwheel">Spin the Wheel</button>
      <div class="verdict" id="wheelverdict">No stakes. No mercy. Endlessly re-spinnable.</div>
    </div>
    <div class="card poll">
      <div class="k" style="font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:10px;">🗳️ Bets &amp; Polls <span class="soon">vote bridges to Discord</span></div>
      <div style="font-weight:600;margin-bottom:8px;">Who's carrying this week?</div>
      <div class="opt"><span style="width:88px;">Amrevenge</span><span class="bar"><i style="width:62%;"></i></span><span class="pct">62%</span></div>
      <div class="opt"><span style="width:88px;">Shadoxii</span><span class="bar"><i style="width:23%;"></i></span><span class="pct">23%</span></div>
      <div class="opt"><span style="width:88px;">The tank</span><span class="bar"><i style="width:15%;"></i></span><span class="pct">15%</span></div>
    </div>
  </div>
</section>

{# ========== ⚙️ ENGINE ROOM ========== #}
<section class="room" id="engine">
  <div class="room-head">
    <div class="porthole">⚙️</div>
    <h2>The Engine Room</h2>
    <p class="sub">The grind that moves the ship — keys pushed, scores climbed, the
      hardest climber of the week.</p>
  </div>
  <div class="grid g3 wrap">
    {%- if wanted.biggest_climb %}
    <div class="card" style="text-align:center;">
      <div class="k" style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);">Biggest Climb</div>
      <div class="big" style="font-family:var(--font-display);font-size:32px;color:#57e08a;">▲ {{ '%.1f'|format(wanted.biggest_climb.delta) }}</div>
      <div class="d" style="color:var(--muted);font-size:13px;">{{ wanted.biggest_climb.name }} · this week's grinder</div>
    </div>
    {%- endif %}
    {%- if records and records.highest_timed_key %}
    <div class="card" style="text-align:center;">
      <div class="k" style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);">Deepest Key Timed</div>
      <div class="big" style="font-family:var(--font-display);font-size:32px;color:var(--heading);">+{{ records.highest_timed_key.level }}</div>
      <div class="d" style="color:var(--muted);font-size:13px;">{{ records.highest_timed_key.dungeon }}</div>
    </div>
    {%- endif %}
    {%- if wanted.top5 and wanted.top5[0].score %}
    <div class="card" style="text-align:center;">
      <div class="k" style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);">Top M+ Score</div>
      <div class="big" style="font-family:var(--font-display);font-size:32px;color:var(--brass);">{{ '%.1f'|format(wanted.top5[0].score) }}</div>
      <div class="d" style="color:var(--muted);font-size:13px;">{{ wanted.top5[0].name }} · at the wheel</div>
    </div>
    {%- endif %}
  </div>
</section>

{# ========== 🧵 SLOP CHEST ========== #}
<section class="room" id="slop-chest">
  <div class="room-head">
    <div class="porthole">🧵</div>
    <h2>The Slop Chest</h2>
    <p class="sub">The armory — who re-cut their look this week. New threads off the rack.</p>
  </div>
  {%- if transmog and transmog.changed %}
  <div class="slop">
    {%- for c in transmog.changed[:8] %}
    <div class="thread"><span class="sw">🧵</span>
      <div><b>{{ c.name }}</b><br><span>{{ [c.spec, c.class]|select|join(' ') }} · new transmog this week</span></div></div>
    {%- endfor %}
  </div>
  {%- else %}
  <p class="sub" style="text-align:center;">Nobody re-cut their look this week. The slop chest is quiet — check back after reset.</p>
  {%- endif %}
</section>

{# ========== 🔒 THE BRIG ========== #}
{%- if ship.brig %}
<section class="room" id="brig">
  <div class="room-head">
    <div class="porthole">🔒</div>
    <h2>The Brig</h2>
    <p class="sub">The bully corner. Affectionate dunking only — and the door's never
      locked from the inside.</p>
  </div>
  <div class="brig">
    <div class="bars" aria-hidden="true"></div>
    <div class="tag">🩹 Healer of Shame</div>
    <div class="shamed">{{ ship.brig.shamed }}</div>
    {%- if ship.brig.note %}<div class="note">{{ ship.brig.note }}</div>{% endif %}
    <div class="optout">{{ ship.brig.optout_note }}</div>
  </div>
</section>
{%- endif %}

{# ========== ⚰️ THE HOLD ========== #}
<section class="room" id="hold">
  <div class="room-head">
    <div class="porthole">⚰️</div>
    <h2>The Hold</h2>
    <p class="sub">{{ ship.hold.caption }} The campfire is load-bearing.</p>
  </div>
  <div class="tombs">
    {%- if ship.hold.reserved %}
    <div class="tomb reserved">
      <div class="rip">Reserved Plot</div>
      <div class="who">{{ ship.hold.reserved }}</div>
      <div class="ep">{{ ship.hold.reserved_note or "Named tenant. Six weeks in the fire." }}</div>
      <div class="fire">🔥</div>
    </div>
    {%- endif %}
    {%- for t in ship.hold.tombstones %}
    <div class="tomb">
      <div class="rip">R.I.P.</div>
      <div class="who">{{ t.name }}</div>
      <div class="ep">{{ t.epitaph }}</div>
    </div>
    {%- endfor %}
  </div>

  {%- if roast %}
  <div class="roast-card">
    <div class="k">🔥 Roast of the Week</div>
    <div class="q">“{{ roast.roast }}”</div>
    <div class="by">— {{ roast.winner }}{% if roast.target %}, aimed at {{ roast.target }}{% endif %}</div>
  </div>
  <p class="hall-flame">Filed in the <b>Hall of Flame</b> · all-time most-roasted crewmember:
    <b>{{ ship.hold.most_roasted }}</b> (that's the joke)</p>
  {%- else %}
  <p class="hall-flame">No roast submitted. <b>Healers live to see another week.</b></p>
  {%- endif %}
</section>

</main>

<footer class="foot">
  <b>S.S. Wipe Fest</b> · a private test run · “Git Gud.” — ancient guild proverb<br>
  Not connected to Discord or the guild website. Nothing here goes anywhere unless you send it.
</footer>

{% include "web/_wanted_script.html.j2" %}
<script>
(function(){
  "use strict";
  // deck manifest: highlight the room you're in
  var chips = Array.prototype.slice.call(document.querySelectorAll('.deckchip'));
  var mani = document.querySelector('.manifest-in');
  var map = {};
  chips.forEach(function(c){ map[c.getAttribute('href').slice(1)] = c; });
  var rooms = Array.prototype.slice.call(document.querySelectorAll('.room'));
  if ('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(ents){
      ents.forEach(function(e){
        if (e.isIntersecting){
          chips.forEach(function(c){ c.classList.remove('active'); });
          var c = map[e.target.id];
          if (c){
            c.classList.add('active');
            // centre the chip WITHIN the manifest only — never call
            // scrollIntoView on a sticky element, it yanks the page to top
            if (mani){ mani.scrollLeft = c.offsetLeft - (mani.clientWidth - c.offsetWidth) / 2; }
          }
        }
      });
    }, {rootMargin:'-45% 0px -50% 0px'});
    rooms.forEach(function(r){ io.observe(r); });
  }

  // Casino: the debt only ever climbs
  var dc = document.getElementById('debtcounter');
  if (dc){
    var owed = parseInt(dc.dataset.owed, 10) || 0;
    setInterval(function(){
      owed += 1337;
      dc.firstChild ? dc.textContent = owed.toLocaleString() : null;
    }, 1500);
  }

  // Casino: the Wheel of Debt
  var disc = document.getElementById('wheeldisc');
  var spin = document.getElementById('spinwheel');
  var verdict = document.getElementById('wheelverdict');
  var VERDICTS = [
    "You owe Brewzleeh 1,337g. No idea why. Pay up.",
    "Healmates stood in the fire. Again. −50 DKP.",
    "The tank pulled early. It was, somehow, your fault.",
    "New title unlocked: “Serial Wiper.” Wear it with pride.",
    "You have been volunteered to heal. Condolences.",
    "The key depleted. That is a you problem.",
    "Brewzleeh doubled down on a 2% chance. It did not hit.",
    "Congratulations — you are now on watch in the Crow's Nest."
  ];
  var turns = 0;
  if (spin && disc){
    spin.addEventListener('click', function(){
      turns += 5 + Math.floor(Math.random()*5);
      disc.style.transform = 'rotate(' + (turns*360 + Math.random()*360) + 'deg)';
      verdict.textContent = '…';
      setTimeout(function(){
        verdict.textContent = VERDICTS[Math.floor(Math.random()*VERDICTS.length)];
      }, 2500);
    });
  }
})();
</script>
{% include "web/_nav_script.html.j2" %}
</body>
</html>
