{# ========================= FOOTER MODULE: graveyard =========================
   The debt tooltip, tombstone memorial with campfire, and item-of-the-month
   card, over the fire-lit stone wall. Self-contained CSS; band height 430px
   (plus the shared MOTD/credits strips the skeleton adds below every footer). #}
<style>
  .ftr{position:relative; width:{{ width }}px; height:430px; overflow:hidden;
    background:url("{{ theme.backgrounds.footer }}");}
  .ftr-fireglow{position:absolute; left:0; right:0; bottom:-70px; height:260px;
    background:radial-gradient(ellipse 60% 100% at 50% 100%, rgba(224,122,40,.30), transparent 70%);
    animation:glowPulse .6s ease-in-out infinite alternate; pointer-events:none;}
  .firerow{position:absolute; left:0; right:0; bottom:-6px; height:150px; pointer-events:none;}
  .ftr-in{position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    gap:40px; padding:0 56px;}
  .tooltip{width:620px; background:rgba(7,7,24,.94); border-radius:8px; padding:18px 26px;
    font-size:17.5px; line-height:1.4;}
  .tooltip.codex{border:1px solid #43435c; box-shadow:inset 0 0 0 1px rgba(120,120,180,.15), 0 14px 40px rgba(0,0,0,.6);}
  .tooltip.item{border:1px solid #5c4a2e; box-shadow:inset 0 0 0 1px rgba(230,180,70,.18), 0 14px 40px rgba(0,0,0,.6);}
  .tooltip .tt{font-family:var(--font-display); font-size:28px; font-weight:800;}
  .tooltip .split{display:flex; justify-content:space-between;}
  .item-img{display:block; margin:12px auto 0; border:2px solid #967a3e; border-radius:6px; max-width:560px; max-height:290px;}
  .memorial{display:flex; flex-direction:column; align-items:center; gap:7px;}
  .memorial .mt{font-size:16px; letter-spacing:.28em; color:var(--accent); font-weight:700; text-shadow:0 1px 4px #000;}
  .gy{position:relative; width:1240px; height:350px; border:3px solid #967a3e; border-radius:10px; overflow:hidden;
    background:linear-gradient(180deg, #12141a 0%, #191d28 55%, #141710 100%);
    box-shadow:0 0 0 1px #2d303a, 0 18px 50px rgba(0,0,0,.65);}
  .gy-glow{position:absolute; left:0; right:0; bottom:-90px; height:260px;
    background:radial-gradient(ellipse 70% 100% at 50% 100%, rgba(58,220,90,.28), transparent 70%);
    animation:glowPulse .6s ease-in-out infinite alternate;}
  .gy-fog{position:absolute; left:0; right:0; bottom:0; height:70px;
    background:linear-gradient(180deg, transparent, #171a10 45%, #0e1009);}
  .gy-row{position:absolute; left:0; right:0; bottom:20px; display:flex; align-items:flex-end;
    justify-content:center; gap:44px;}
  .grave{display:flex; flex-direction:column; align-items:center; gap:9px;}
  .stone{display:flex; flex-direction:column; align-items:center; gap:6px; padding-top:24px;
    box-shadow:inset 0 4px 6px rgba(255,255,255,.18), inset 0 -10px 18px rgba(0,0,0,.45), 0 12px 26px rgba(0,0,0,.6);}
  .stone .rip{font-family:var(--font-display); font-size:24px; font-weight:900; color:#211f1b; text-shadow:0 1px 0 rgba(255,255,255,.25);}
  .stone .cross{width:26px; height:52px; position:relative;}
  .stone .cross i{position:absolute; background:#2c2a25; border-radius:3px;}
  .stone .cnm{font-family:var(--font-display); font-weight:900; letter-spacing:.02em; white-space:nowrap;
    text-shadow:0 1px 0 rgba(255,255,255,.30), 0 -1px 1px rgba(0,0,0,.35);}
  .plate{position:relative; z-index:2; background:rgba(8,10,6,.9); border:2px solid #967a3e;
    border-radius:8px; padding:8px 16px 9px; text-align:center;
    box-shadow:0 8px 20px rgba(0,0,0,.55);}
  .plate .nm{font-size:21px; font-weight:800; color:#f4f0e4; letter-spacing:.02em; white-space:nowrap;}
  .plate .dd{font-size:15px; font-weight:700; color:var(--accent); margin-top:3px; white-space:nowrap;}
  .plot{display:flex; flex-direction:column; align-items:center; gap:6px; width:190px;}
  .fire{position:relative; width:120px; height:120px;}
  .fire .log{position:absolute; bottom:2px; width:64px; height:12px; border-radius:6px;
    background:linear-gradient(180deg, #5a4028, #2b2117);}
  .reserved{background:#3a2c1a; border:2px solid #211809; border-radius:6px; padding:6px 12px;
    font-size:14px; font-weight:800; letter-spacing:.08em; color:#d9c49a; box-shadow:0 6px 16px rgba(0,0,0,.5);}
  .plot .weeks{font-size:13px; color:#8d93a2; font-style:italic;}
  .gy-cap{font-size:16px; color:#c3c8d2; font-style:italic; text-shadow:0 1px 4px #000;}
</style>
<div class="ftr">
  <div class="ftr-fireglow"></div>
  <div class="firerow">
    {%- for f in footer_flames %}
    <div style="position:absolute; left:{{ f.left }}%; bottom:0; width:{{ f.w }}px; height:{{ f.h }}px;">
      <div class="flame" style="width:{{ f.w }}px; height:{{ f.h }}px; margin-left:-{{ f.w // 2 }}px; background:radial-gradient(circle at 50% 88%, rgba(224,122,40,.85), rgba(224,122,40,.08) 78%); animation-duration:{{ f.dur }}s; animation-delay:{{ f.delay }}s;"></div>
      <div class="flame" style="width:{{ (f.w * 0.55) | int }}px; height:{{ (f.h * 0.66) | int }}px; margin-left:-{{ (f.w * 0.55 / 2) | int }}px; background:radial-gradient(circle at 50% 88%, rgba(246,176,78,.8), rgba(246,176,78,.06) 78%); animation-duration:{{ f.dur2 }}s; animation-delay:{{ f.delay }}s;"></div>
    </div>
    {%- endfor %}
  </div>
  <div class="embers">
    {%- for e in footer_embers %}
    <span style="left:{{ e.left }}%; width:{{ e.size }}px; height:{{ e.size }}px; animation-delay:{{ e.delay }}s; --drift:{{ e.drift }}px;"></span>
    {%- endfor %}
  </div>
  <div class="ftr-in">
    {%- if debt_card %}
    <div class="tooltip codex">
      <div class="tt" style="color:var(--legendary);">{{ debt_card.title }}</div>
      <div style="display:flex; align-items:baseline; gap:10px; margin:5px 0 2px; font-variant-numeric:tabular-nums;">
        <span data-count data-base="{{ debt_card.amount }}" data-step="1337" data-ticks="4"
              style="font-size:40px; font-weight:800; color:var(--accent); animation:debtGlow .6s ease-in-out infinite alternate;">{{ "{:,}".format(debt_card.amount) }}</span>
        <span class="coin" style="display:inline-block; border-radius:50%; width:18px; height:18px; background:radial-gradient(circle at 35% 30%, #ffe9a8, #e6b446 55%, #8a6420);"></span>
        <span style="font-size:14px; color:var(--muted);">{{ debt_card.climbing_note }}</span>
      </div>
      <div style="font-size:14px; color:var(--muted); margin-bottom:7px;">{{ debt_card.interest_note }}</div>
      {%- for line in debt_card.lines %}
      {%- if line.right %}
      <div class="split"><span>{{ line.left }}</span><span>{{ line.right }}</span></div>
      {%- else %}
      <div {% if line.green %}style="color:var(--uncommon);"{% endif %}>{{ line.left }}</div>
      {%- endif %}
      {%- endfor %}
      {%- if debt_card.flavor %}<div style="color:var(--goldtext); font-style:italic; margin-top:7px;">{{ debt_card.flavor }}</div>{% endif %}
      {%- if debt_card.requires %}<div style="color:#ff2020; margin-top:5px;">{{ debt_card.requires }}</div>{% endif %}
    </div>
    {%- endif %}
    <div class="memorial">
      <div class="mt">{{ theme.footer.graveyard.title }}{% if week_label %} · WEEK OF {{ week_label.upper() }}{% endif %}</div>
      <div class="gy">
        <div class="gy-glow"></div>
        <div class="embers wisps">
          {%- for e in wisps %}
          <span style="left:{{ e.left }}%; width:{{ e.size }}px; height:{{ e.size }}px; animation-delay:{{ e.delay }}s; --drift:{{ e.drift }}px;"></span>
          {%- endfor %}
        </div>
        <div class="gy-fog"></div>
        <div class="gy-row">
          {%- for s in stones %}
          <div class="grave">
            <div class="stone" style="width:{{ s.w }}px; height:{{ s.h }}px; transform:rotate({{ s.rot }}deg);
                 background:linear-gradient(165deg, {{ s.light }} 0%, {{ s.mid }} 55%, {{ s.dark }} 100%);
                 border-radius:{{ s.radius }};">
              {%- if s.cross %}<div class="cross"><i style="left:10px; top:0; width:7px; height:52px;"></i><i style="left:0; top:12px; width:26px; height:7px;"></i></div>
              {%- else %}<div class="rip">R.I.P.</div>{% endif %}
              <div class="cnm" style="font-size:{{ s.carve_size }}px; color:{{ s.carve_color }};">{{ s.name }}</div>
            </div>
            <div class="plate">
              <div class="nm" style="color:{{ s.color }};">{{ s.name }}</div>
              <div class="dd">{{ s.deaths }}</div>
            </div>
          </div>
          {%- endfor %}
          <div class="plot">
            <div class="fire">
              <div style="position:absolute; left:50%; bottom:6px; transform:translateX(-50%); width:60px; height:90px;">
                <div class="flame" style="width:56px; height:84px; margin-left:-28px; filter:blur(3px); background:radial-gradient(circle at 50% 85%, #e07a28, rgba(224,122,40,.15) 75%); animation-duration:.6s;"></div>
                <div class="flame" style="width:36px; height:64px; margin-left:-18px; filter:blur(3px); background:radial-gradient(circle at 50% 85%, #f6b04e, rgba(246,176,78,.2) 75%); animation-duration:.3s;"></div>
                <div class="flame" style="width:18px; height:40px; margin-left:-9px; filter:blur(3px); background:radial-gradient(circle at 50% 85%, #ffe9a8, rgba(255,233,168,.25) 75%); animation-duration:.2s;"></div>
              </div>
              <div class="log" style="left:14px; transform:rotate(-14deg);"></div>
              <div class="log" style="right:14px; transform:rotate(14deg);"></div>
            </div>
            <div class="reserved">RESERVED: {{ theme.footer.graveyard.reserved }}</div>
            <div class="weeks">{{ theme.footer.graveyard.reserved_note }}</div>
          </div>
        </div>
      </div>
      <div class="gy-cap">{{ theme.footer.graveyard.caption }}</div>
    </div>
    <div class="tooltip item">
      <div class="tt" style="color:var(--legendary);">{{ item_title }}</div>
      {%- if item_src %}<img class="item-img" src="{{ item_src }}" alt="">{% else %}
      <div style="color:var(--muted); text-align:center; padding:40px 0;">{{ theme.footer.item_empty }}</div>{% endif %}
    </div>
  </div>
</div>
