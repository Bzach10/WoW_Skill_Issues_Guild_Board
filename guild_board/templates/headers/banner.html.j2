{# ========================== HEADER MODULE: banner ==========================
   A clean alternative: the guild name in big display type over the header
   art, subtitle beneath, embers rising. No widgets, no gags — good when
   the art should carry the top of the board. Band height: 190px.
   (theme.yml: board.header: banner) #}
<style>
  .hdr{position:relative; width:{{ width }}px; height:190px; overflow:hidden;
       background:url("{{ theme.backgrounds.header }}") center/cover;}
  .hdr-shade{position:absolute; inset:0;
    background:linear-gradient(180deg, rgba(8,8,11,.25), rgba(8,8,11,.72));}
  .hdr-title{position:absolute; inset:0; display:flex; flex-direction:column;
    align-items:center; justify-content:center; gap:6px;}
  .hdr-name{font-family:var(--font-display); font-size:84px; font-weight:900;
    letter-spacing:.12em; color:var(--text); text-shadow:0 4px 18px #000, 0 0 40px rgba(230,180,70,.35);}
  .hdr-sub{font-size:18px; letter-spacing:.44em; color:var(--accent); font-weight:700;
    text-shadow:0 2px 8px #000;}
  .hdr-glow{position:absolute; left:0; right:0; bottom:-60px; height:180px;
    background:radial-gradient(ellipse 55% 100% at 50% 100%, rgba(224,122,40,.25), transparent 70%);
    animation:glowPulse .6s ease-in-out infinite alternate; pointer-events:none;}
  .hdr-fade{position:absolute; left:0; right:0; bottom:0; height:26px;
    background:linear-gradient(180deg, transparent, rgba(8,8,11,.85));}
</style>
<div class="hdr">
  <div class="hdr-shade"></div>
  <div class="hdr-glow"></div>
  <div class="embers">
    {%- for e in header_embers %}
    <span style="left:{{ e.left }}%; width:{{ e.size }}px; height:{{ e.size }}px; animation-delay:{{ e.delay }}s; --drift:{{ e.drift }}px;"></span>
    {%- endfor %}
  </div>
  <div class="hdr-title">
    <div class="hdr-name">{{ guild_name.upper() }}</div>
    <div class="hdr-sub">{{ realm_label }}</div>
  </div>
  <div class="hdr-fade"></div>
</div>
